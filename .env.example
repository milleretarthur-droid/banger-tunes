# --- Supabase > Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# clé "anon public" (visible côté navigateur, c'est normal)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# clé "service_role" : SECRÈTE, serveur uniquement. Ne JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
# Developers > Webhooks > ton endpoint > "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs des 3 prix (Product catalog > produit > prix) : price_...
STRIPE_PRICE_LIVE=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# --- Alertes email (lot 2) ---
# Secret du cron Vercel : n'importe quelle longue chaîne aléatoire (Vercel l'envoie en "Bearer")
CRON_SECRET=une-longue-chaine-aleatoire
# Resend (resend.com) > API Keys
RESEND_API_KEY=re_...
# Expéditeur sur un domaine vérifié dans Resend
ALERT_FROM_EMAIL=Banger Tunes <alertes@ton-domaine.fr>
# Optionnel : URL publique utilisée dans les emails (sinon déduite de Vercel)
# SITE_URL=https://banger-tunes.vercel.app

# --- Digger (lot 19) : application Discogs (discogs.com/settings/developers > Créer une application) ---
DISCOGS_KEY=...
DISCOGS_SECRET=...
